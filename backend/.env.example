# Copy this file to backend/.env and fill it with the keys of ONE non-production Notifizz environment
# (dashboard: the SDK setup page). A campaign in Review never delivers in production.
# The front API key of the same environment goes to the frontend: frontend/src/environments/.

# Secret: signs each user's notification center token. Never sent to the browser.
NOTIFIZZ_AUTH_SECRET_KEY=
# Secret: sends the events (track). Never sent to the browser.
NOTIFIZZ_SDK_SECRET_KEY=
